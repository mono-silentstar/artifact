# Deny access to sensitive files
<FilesMatch "\.(php|sqlite|json|jsonl|md|py|yml|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Allow PHP files in web root and api/
<FilesMatch "^(index|manifest)\.">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

# Note: api/ directory re-allows PHP execution via its own .htaccess
# Note: lib/ directory protected by its own .htaccess

# Deny access to config files
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

<Files "config.local.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
